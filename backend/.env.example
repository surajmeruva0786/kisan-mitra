# Port the API server listens on
PORT=4000

# Comma-separated list of allowed CORS origins (frontend dev server, deployed frontend URL)
CORS_ORIGIN=http://localhost:5173

# Optional: enable real LLM-backed chat responses via Google Gemini.
# Leave unset to use the built-in rule-based responder (no external calls, no cost).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
